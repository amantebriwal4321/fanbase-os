# Optional. Leave every key empty and the desk still groups notes with house rules.
# If more than one key is set, GEMINI_API_KEY wins.

# Gemini. Used to name topics and write one line summaries.
GEMINI_API_KEY=

# OpenAI, or any OpenAI compatible chat API. Used only when GEMINI_API_KEY is empty.
OPENAI_API_KEY=

# Alias for OPENAI_API_KEY.
AI_API_KEY=

# OpenAI compatible base URL. Default: https://api.openai.com/v1
AI_BASE_URL=

# Overrides the model for whichever provider is active.
# Gemini default: gemini-2.5-flash
# OpenAI default: gpt-4o-mini
AI_MODEL=
