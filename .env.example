# Postgres connection string from Neon or Supabase.
# If this is empty, the app stores data in data/store.json (or /tmp on Vercel).
DATABASE_URL=

# Set to disable for a local Postgres that does not use SSL.
DATABASE_SSL=

# Signs session cookies and magic links. Set a long random value in production.
AUTH_SECRET=

# Public site URL, no trailing slash. Used for magic links and GitHub callback.
# Example: https://your-app.vercel.app
APP_URL=

# Model key. AI_API_KEY wins. OPENAI_API_KEY is the fallback name.
# Leave both empty to use the built in house rules.
AI_API_KEY=
OPENAI_API_KEY=

# OpenAI compatible base URL. Default: https://api.openai.com/v1
# For Vercel AI Gateway use https://ai-gateway.vercel.sh/v1
AI_BASE_URL=

# Default: gpt-4o-mini
AI_MODEL=

# Optional GitHub OAuth. Callback: {APP_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional. When set, magic links are emailed with Resend.
# When empty, the sign in page shows the link so the demo still works.
RESEND_API_KEY=
EMAIL_FROM=
